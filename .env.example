# GEIR. Copy this file as .env and change only what you need.
# No passwords or tokens here: each person signs in with their own user, and their session
# lives only in the server's memory and in their browser's sessionStorage.

# --- Shared server (Linux) ---------------------------------------------------------------
# 0.0.0.0 accepts connections from other machines. Put it behind nginx with HTTPS
# (deploy/nginx-geir.conf): the network password travels in the sign-in.
GEIR_HOST=0.0.0.0
GEIR_PORT=4300
# true when a proxy (nginx / IIS) in front terminates HTTPS.
GEIR_TRUST_PROXY=true
# Paths on the server's disk: always false on a shared server.
GEIR_ALLOW_LOCAL_PATHS=false
# Browser for background sign-ins: chromium (Linux) or msedge (Windows).
GEIR_BROWSER=chromium
# Chromium folder (install it with: PLAYWRIGHT_BROWSERS_PATH=/opt/geir/ms-playwright npm run browser:install)
PLAYWRIGHT_BROWSERS_PATH=/opt/geir/ms-playwright

# --- Your services (required outside demo mode) ---------------------------------------------
# The real values of this installation go in .env.local (git-ignored), not in the repository.
# AZURE_DEVOPS_URL=http://azure-devops-server
# GITLAB_BASE_URL=https://gitlab.example.com
# AZURE_COLLECTION=Collection
# AZURE_PROJECT=Project
# AZURE_TEAM=Team
# GITLAB_PROJECTS=group/project
# SHAREPOINT_SITE=company-my.sharepoint.com
# MICROSOFT_EMAIL_DOMAIN=example.com
# HTTPS_PROXY=http://proxy:8080
# GEIR_CONFIG_DIR=/etc/geir/config

# --- Branch builds (admin option "Rama") --------------------------------------------------
# Local clone of the source repository: GEIR pulls there. Empty: it looks for a folder named
# GEIR_REPO_NAME next to the GEIR folder; if there is none, it clones GITLAB_BASE_URL/GEIR_REPO_PROJECT.
# GEIR_REPO_DIR=C:\dev\my-repo
# GEIR_REPO_NAME=my-repo
# GEIR_REPO_PROJECT=group/project
# GEIR_REPOS_DIR=/opt/geir/repos
# JDK 8 for Maven (Linux: /usr/lib/jvm/java-8-openjdk-amd64; Windows: C:\Program Files\Java\jdk1.8.0_202)
# GEIR_JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
# GEIR_MAVEN_REPO=/opt/geir/.m2/repository
# GEIR_GIT_SSL_VERIFY=false
# GEIR_BUILD_TIMEOUT_MIN=30
